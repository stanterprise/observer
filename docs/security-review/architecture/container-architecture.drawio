<mxfile host="app.diagrams.net" type="device">
  <diagram id="observer-containers" name="Container architecture">
    <mxGraphModel dx="1900" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Observer: current container architecture (distributed mode)" style="text;html=0;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1000" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Current application behavior; operator-managed public gRPC and VPN/private Web entry paths are detailed in the Kubernetes deployment view." style="text;html=0;align=left;verticalAlign=middle;fontSize=14;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="30" y="65" width="1500" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="system" value="Observer system boundary" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;fontSize=15;fontStyle=1;fillColor=#F8FAFC;strokeColor=#64748B;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="110" width="1300" height="800" as="geometry"/>
        </mxCell>
        <mxCell id="runner" value="CI / test runners&#xa;Playwright, pytest, or&#xa;compatible gRPC client" style="rounded=1;whiteSpace=wrap;html=0;fontSize=15;fontStyle=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="30" y="200" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="engineer" value="Engineer / browser&#xa;via organization VPN/private route&#xa;no application user auth" style="rounded=1;whiteSpace=wrap;html=0;fontSize=15;fontStyle=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="30" y="610" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="wsclient" value="Optional WebSocket client&#xa;live event stream" style="rounded=1;whiteSpace=wrap;html=0;fontSize=15;fontStyle=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="790" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="ingestion" value="Ingestion&#xa;gRPC :50051&#xa;shared bearer key required&#xa;in distributed mode" style="rounded=1;whiteSpace=wrap;html=0;fontSize=15;fontStyle=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="350" y="200" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="nats" value="NATS JetStream&#xa;tests_events stream&#xa;filter: tests.events.v1.&gt;" style="shape=cylinder;spacingTop=24;whiteSpace=wrap;html=0;fontSize=15;fontStyle=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;" vertex="1" parent="1">
          <mxGeometry x="650" y="200" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="processor" value="Event processor&#xa;Go consumer&#xa;persists test results" style="rounded=1;whiteSpace=wrap;html=0;fontSize=15;fontStyle=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="950" y="200" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="mongo" value="MongoDB&#xa;transient live_step_buffers" style="shape=cylinder;spacingTop=24;whiteSpace=wrap;html=0;fontSize=15;fontStyle=1;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="1250" y="200" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="web" value="Web container&#xa;Nginx serves React and&#xa;proxies API / WebSocket" style="rounded=1;whiteSpace=wrap;html=0;fontSize=15;fontStyle=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="350" y="610" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="API&#xa;REST and optional WebSocket&#xa;no application user auth" style="rounded=1;whiteSpace=wrap;html=0;fontSize=15;fontStyle=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="650" y="610" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="postgres" value="PostgreSQL&#xa;durable runs, tests,&#xa;attempts and inline data" style="shape=cylinder;spacingTop=24;whiteSpace=wrap;html=0;fontSize=15;fontStyle=1;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="950" y="610" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="object" value="Optional S3-compatible&#xa;attachment storage&#xa;location is configurable" style="shape=cylinder;spacingTop=24;whiteSpace=wrap;html=0;fontSize=15;fontStyle=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1650" y="440" width="210" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="Blue: Observer application   |   Purple: messaging   |   Green: data store   |   Amber: external actor / optional store&#xa;Arrows show the initiating component; pull requests return event data. Dashed paths are optional.&#xa;Distributed gRPC uses one shared bearer key; it does not authorize by project/run.&#xa;Web/API have no application AuthN/AuthZ. VPN/private-network access, TLS, and external routes are operator controls, not chart-enforced. Local/AIO is outside this InfoSec package's scope." style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=10;fontSize=13;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="350" y="740" width="1250" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="runner-ingestion" value="gRPC events&#xa;via operator gateway (see deployment view)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=0;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#334155;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="runner" target="ingestion">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ingestion-nats" value="publish&#xa;NATS :4222" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=0;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#334155;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ingestion" target="nats">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="processor-nats" value="pull events&#xa;NATS :4222" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=0;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#334155;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="processor" target="nats">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="processor-mongo" value="buffer steps&#xa;MongoDB :27017" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=0;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#334155;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="processor" target="mongo">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="processor-postgres" value="write results&#xa;PostgreSQL :5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=0;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#334155;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="processor" target="postgres">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="api-nats" value="pull live events&#xa;NATS :4222" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=0;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#334155;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="api" target="nats">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="api-postgres" value="read / update&#xa;SQL :5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=0;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#334155;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="api" target="postgres">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="engineer-web" value="UI + REST&#xa;HTTPS at VPN/private edge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=0;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#334155;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="engineer" target="web">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ws-web" value="optional /ws&#xa;HTTP upgrade" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=0;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="wsclient" target="web">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="285" y="825"/>
              <mxPoint x="285" y="682"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="web-api" value="proxy /api, /ws&#xa;HTTP :8080" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=0;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#334155;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="web" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="processor-object" value="optional upload: S3 HTTP(S), configured endpoint" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=0;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;dashed=1;exitX=0.8;exitY=1;entryX=0;entryY=0.35;" edge="1" parent="1" source="processor" target="object">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1110" y="400"/>
              <mxPoint x="1615" y="400"/>
              <mxPoint x="1615" y="478"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="api-object" value="optional S3 GET on fallback; API can sign a redirect" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=0;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;dashed=1;exitX=0.75;exitY=1;entryX=0;entryY=0.75;" edge="1" parent="1" source="api" target="object">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="800" y="870"/>
              <mxPoint x="1605" y="870"/>
              <mxPoint x="1605" y="522"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="browser-object" value="optional browser follow of signed or configured URL: HTTP(S), configured endpoint" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=0;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;dashed=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="engineer" target="object">
          <mxGeometry relative="1" as="geometry">
