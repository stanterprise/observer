        <mxCell id="processor-mongo" value="steps&#xa;Mongo :27017" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=0;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#334155;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="processor" target="mongo">
