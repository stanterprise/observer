          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="api-nats" value="pull relay events&#xa;TCP :4222" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=0;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#334155;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="api" target="nats">
