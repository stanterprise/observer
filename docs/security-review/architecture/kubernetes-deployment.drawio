<mxfile host="app.diagrams.net" type="device">
  <diagram id="observer-kubernetes" name="Kubernetes deployment">
    <mxGraphModel dx="1960" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Observer: current Helm deployment and network boundaries" style="text;html=0;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="20" y="15" width="1300" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Current distributed Helm resources plus intended operator-managed entry paths; VPN, gateways, and TLS are not installed or enforced by the chart." style="text;html=0;align=left;verticalAlign=middle;fontSize=14;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="1750" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="cluster" value="Company-managed Kubernetes cluster (logical boundary)" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=15;fontStyle=1;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="260" y="110" width="1385" height="900" as="geometry"/>
        </mxCell>
        <mxCell id="release" value="Observer Helm release: bundled dependency defaults" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=15;fontStyle=1;fillColor=#FFFFFF;strokeColor=#94A3B8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="155" width="1085" height="805" as="geometry"/>
        </mxCell>
        <mxCell id="runner" value="CI / test runners&#xa;may be outside cluster" style="rounded=1;whiteSpace=wrap;html=0;fontSize=15;fontStyle=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="20" y="220" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="browser" value="Engineer on organization VPN&#xa;Browser and optional /ws clients&#xa;(no application user auth)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=15;fontStyle=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="20" y="610" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="grpc-entry" value="Public gRPC gateway&#xa;Operator-managed TLS/HTTP2 :443&#xa;not rendered by Helm" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fontStyle=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#78350F;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="285" y="220" width="210" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="web-entry" value="VPN / private web gateway&#xa;Operator-managed HTTPS :443&#xa;not rendered by Helm" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fontStyle=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#78350F;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="285" y="610" width="210" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="ingestion" value="Ingestion Deployment&#xa;ClusterIP Service :50051&#xa;gRPC health probe" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fontStyle=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="565" y="220" width="205" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="nats" value="NATS JetStream&#xa;StatefulSet + Service :4222&#xa;10 Gi PVC; monitor :8222" style="shape=cylinder;spacingTop=24;whiteSpace=wrap;html=0;fontSize=14;fontStyle=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;" vertex="1" parent="1">
          <mxGeometry x="840" y="220" width="205" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="processor" value="Processor Deployment&#xa;no Service&#xa;pulls and persists events" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fontStyle=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="1115" y="220" width="205" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="mongo" value="MongoDB Deployment&#xa;Service :27017&#xa;10 Gi PVC; live buffers" style="shape=cylinder;spacingTop=24;whiteSpace=wrap;html=0;fontSize=14;fontStyle=1;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="1390" y="220" width="205" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="web" value="Web Deployment&#xa;ClusterIP Service :80&#xa;Nginx + React assets" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fontStyle=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="565" y="610" width="205" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="API Deployment&#xa;ClusterIP Service :8080&#xa;REST + /ws relay" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fontStyle=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="840" y="610" width="205" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="postgres" value="PostgreSQL StatefulSet&#xa;Service :5432&#xa;10 Gi PVC; durable results" style="shape=cylinder;spacingTop=24;whiteSpace=wrap;html=0;fontSize=14;fontStyle=1;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="1115" y="610" width="205" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="ingestion-secret" value="Operator Secret (required)&#xa;INGESTION_AUTH_KEY&#xa;referenced by ingestion" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fontStyle=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="565" y="380" width="205" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="runtime-secret" value="Runtime / dependency Secrets&#xa;NATS URL, DB credentials&#xa;optional S3 settings + CA" style="rounded=1;whiteSpace=wrap;html=0;fontSize=13;fontStyle=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="840" y="810" width="205" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="migration" value="Migration hook Job&#xa;PostgreSQL schema&#xa;namespace default account" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fontStyle=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="1115" y="810" width="205" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="external-deps" value="Optional external replacements&#xa;PostgreSQL / MongoDB / NATS&#xa;workloads use configured endpoints&#xa;and TLS settings" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fontStyle=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#78350F;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1680" y="200" width="230" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="object" value="Optional S3-compatible store&#xa;location and endpoint selected&#xa;browser may follow redirect" style="shape=cylinder;spacingTop=24;whiteSpace=wrap;html=0;fontSize=14;fontStyle=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#78350F;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1680" y="480" width="230" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="platform" value="Hosting platform / outside chart&#xa;DNS, routing and TLS; PV provisioner;&#xa;image registry access; Secret delivery;&#xa;monitoring and network controls&#xa;(may be provided inside the cluster)" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=10;fontSize=13;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#78350F;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1680" y="760" width="230" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="Blue: workload + Service   |   Cylinders: bundled messaging / stores and PVCs   |   Grey: Secret/config   |   Dashed: operator-provided, not chart-enforced&#xa;Public gRPC uses the shared bearer key at Ingestion; it is not project/run authorization. Prevent gateway bypass and rate-limit at the edge.&#xa;Web/API are intended to be VPN/private-only, but have no application user AuthN/AuthZ. A directly exposed API Service bypasses the web route." style="text;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontSize=13;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="285" y="955" width="1320" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="runner-entry" value="gRPC / TLS :443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=0;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="runner" target="grpc-entry">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="entry-ingestion" value="gRPC :50051&#xa;backend TLS is deployment-specific" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=0;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="grpc-entry" target="ingestion">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ingestion-nats" value="publish&#xa;TCP :4222" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=0;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#334155;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ingestion" target="nats">
          <mxGeometry relative="1" as="geometry"/>
