        <mxCell id="browser-entry" value="HTTPS :443&#xa;VPN/private access" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=0;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="browser" target="web-entry">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="entry-web" value="HTTP :80&#xa;backend TLS not chart-configured" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=0;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="web-entry" target="web">
